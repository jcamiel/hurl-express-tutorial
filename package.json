    "express-validator": "7.3.2",
    "handlebars-helper-range": "1.1.1",
    "hbs": "4.2.1",
    "morgan": "1.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/csurf": "1.11.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/hbs": "4.0.5",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/node": "25.6.0",
    "@types/on-headers": "1.0.4",
    "copyfiles": "2.4.1",
