  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "postbuild": "copyfiles --up 1 src/views/**/* src/views/* src/public/**/* src/public/* dist",
    "fmt": "prettier --write src/ \"!**/*.hbs\" ",
